# 统一换行，避免跨平台 diff 噪音；下方 LFS 规则对二进制优先接管
*          text=auto eol=lf

# 硬件二进制统一走 LFS，否则首次提交原理图就会把仓库撑爆
*.SchDoc   filter=lfs diff=lfs merge=lfs -text
*.SchDot   filter=lfs diff=lfs merge=lfs -text
*.PcbDoc   filter=lfs diff=lfs merge=lfs -text
*.PcbLib   filter=lfs diff=lfs merge=lfs -text
*.SchLib   filter=lfs diff=lfs merge=lfs -text
*.GBR      filter=lfs diff=lfs merge=lfs -text
*.zip      filter=lfs diff=lfs merge=lfs -text
*.step     filter=lfs diff=lfs merge=lfs -text
*.stp      filter=lfs diff=lfs merge=lfs -text
*.stl      filter=lfs diff=lfs merge=lfs -text
*.xlsx     filter=lfs diff=lfs merge=lfs -text
*.xls      filter=lfs diff=lfs merge=lfs -text
*.docx     filter=lfs diff=lfs merge=lfs -text
*.pdf      filter=lfs diff=lfs merge=lfs -text
*.hex      filter=lfs diff=lfs merge=lfs -text
*.bin      filter=lfs diff=lfs merge=lfs -text
*.img      filter=lfs diff=lfs merge=lfs -text

# 文本类强制 LF，避免跨平台 diff 噪音
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.csv      text eol=lf
*.c        text eol=lf
*.h        text eol=lf
*.py       text eol=lf
